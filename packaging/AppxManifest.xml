<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  IgnorableNamespaces="uap rescap desktop">

  <Identity Name="KayhanTEKN.DeskZones"
            Publisher="CN=A94C9337-5C18-44C3-9DCE-433C130AD6A2"
            Version="VERSION_PLACEHOLDER"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Desk Zones</DisplayName>
    <PublisherDisplayName>Kayhan TEKİN</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="tr-tr" />
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="DeskZones.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Desk Zones"
        Description="Masaüstünü isimli bölmelere ayırır ve yeni dosyaları otomatik yerleştirir."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="DeskZones.exe"
                           EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="DeskZonesStartup" Enabled="false" DisplayName="DeskZones" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
