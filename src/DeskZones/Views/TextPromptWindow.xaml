<Window x:Class="DeskZones.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="ToolWindow">
    <StackPanel Margin="16">
        <TextBlock x:Name="LabelText" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <TextBox x:Name="Input" Padding="6" FontSize="14"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Tamam" Width="80" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="İptal" Width="80" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
