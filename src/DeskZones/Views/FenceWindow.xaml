<Window x:Class="DeskZones.Views.FenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        MinWidth="186" MinHeight="132" AllowDrop="True"
        WindowStartupLocation="Manual" Title="DeskZones">

    <Window.Resources>
        <Style TargetType="ListBoxItem">
            <Setter Property="Width" Value="84"/>
            <Setter Property="Height" Value="84"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="8" Background="#B3162B3A" BorderBrush="#40FFFFFF" BorderThickness="1">
        <Border.ContextMenu>
            <ContextMenu x:Name="FenceMenu">
                <MenuItem Header="Adı değiştir" Click="Rename_Click"/>
                <MenuItem Header="Otomatik yerleştirme kuralları…" Click="Rules_Click"/>
                <MenuItem Header="Varsayılan bölme yap" Click="Default_Click"/>
                <Separator/>
                <MenuItem Header="Yeni bölme" Click="NewFence_Click"/>
                <MenuItem Header="Tüm bölmeleri hizala" Click="Arrange_Click"/>
                <MenuItem Header="Bu bölmeyi sil" Click="Delete_Click"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#66000000" CornerRadius="7,7,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <TextBlock x:Name="TitleText" Foreground="White" FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="10,0"/>
                    <TextBox x:Name="TitleBox" Visibility="Collapsed" Margin="8,4" FontSize="13"
                             VerticalContentAlignment="Center"
                             KeyDown="TitleBox_KeyDown" LostFocus="TitleBox_LostFocus"/>
                </Grid>
            </Border>

            <ListBox x:Name="ItemsList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                     Margin="4" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="ItemsList_MouseDoubleClick"
                     PreviewMouseLeftButtonDown="ItemsList_PreviewMouseLeftButtonDown"
                     PreviewMouseRightButtonDown="ItemsList_PreviewMouseRightButtonDown"
                     PreviewMouseMove="ItemsList_PreviewMouseMove"
                     ContextMenuOpening="ItemsList_ContextMenuOpening">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Aç" Click="OpenItem_Click"/>
                        <MenuItem Header="Dosya konumunu göster" Click="ShowItem_Click"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel ToolTip="{Binding FullPath}">
                            <Image Source="{Binding Icon}" Width="36" Height="36" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis" MaxHeight="34" Margin="0,4,0,0">
                                <TextBlock.Effect>
                                    <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.9"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</Window>
